# =============================================
# Machine-specific secrets and environment variables
# Copy this to ~/.env.local and fill in your values
# This file is NOT tracked by git
# =============================================

# AWS
# export AWS_PROFILE=your_profile
# export AWS_ACCESS_KEY_ID=
# export AWS_SECRET_ACCESS_KEY=
# export AWS_REGION=eu-central-1

# CodeArtifact (Ruby gems)
# export CODEARTIFACT_URL=https://your-domain.d.codeartifact.region.amazonaws.com/ruby/repo
# export CODEARTIFACT_AUTH_TOKEN=$(aws codeartifact get-authorization-token --domain your-domain --domain-owner 123456789 --region eu-central-1 --query authorizationToken --output text)
# export RUBYGEMS_HOST=$CODEARTIFACT_URL

# Sidekiq Pro
# export SIDEKIQ_USER=admin
# export SIDEKIQ_PASSWORD=your_password

# PostgreSQL (if not using default)
# export POSTGRES_HOST=db

# API tokens
# export OPENROUTER_API_KEY=your_key
